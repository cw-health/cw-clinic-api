# Copy to .env for local development. Never commit the real .env file.

# Runtime
NODE_ENV=development
PORT=3000

# Database (SQL Server) — see docs/DATABASE.md
DATABASE_URL="sqlserver://localhost:1433;database=cw_clinic;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"

# CORS — comma-separated exact origins, never "*" (see docs/SECURITY.md §10)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (docs/SECURITY.md §6)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info

# Swagger — served at /api/docs, non-production environments only (docs/API.md §7)
API_DOCS_ENABLED=true
