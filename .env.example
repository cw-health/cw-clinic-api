# Copy to .env for local development. Never commit the real .env file.

# Runtime
NODE_ENV=development
PORT=3000

# Database (SQL Server) — see docs/DATABASE.md
DATABASE_URL="sqlserver://localhost:1433;database=cw_clinic;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"

# CORS — comma-separated exact origins, never "*" (see docs/SECURITY.md §10)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (docs/SECURITY.md §6)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth (docs/SECURITY.md §1) — generate with e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=cw_refresh_token

# Logging
LOG_LEVEL=info

# Swagger — served at /api/docs, non-production environments only (docs/API.md §7)
API_DOCS_ENABLED=true

# Document storage (docs/SECURITY.md §9, docs/DECISIONS.md ADR-008)
STORAGE_DRIVER=local
# local-disk root for uploaded patient documents, outside the public
# webroot. Relative paths resolved against process.cwd(); created
# automatically if missing. Used when STORAGE_DRIVER=local.
DOCUMENTS_STORAGE_DIR=./storage/documents
# Used when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Redis / BullMQ (docs/DECISIONS.md ADR-008) — backs the `jobs` module's
# notification-delivery queue.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# FCM service account credentials (JSON, single line) for
# FcmNotificationProvider. Left empty in dev — the provider then logs and
# skips push delivery instead of crashing the app.
FCM_SERVICE_ACCOUNT_JSON=
